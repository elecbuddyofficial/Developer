# Plaintext content backups — must never be committed, they would
# re-expose premium content that is encrypted everywhere else.
data/Orals/Backup/
data/**/Backup/
data/PLAINTEXT_BACKUP_do_not_delete/

# Local key storage — never commit real secret values
DecryptEncrypt/

# Supabase CLI local state, not project config
supabase/.temp/

# Tooling only (sharp, for diagram conversion). There is no package.json here;
# this repo ships as a static site, so node_modules is never part of a deploy.
node_modules/
